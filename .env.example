# Vercel Blob adds BLOB_STORE_ID when the private store is connected.
BLOB_STORE_ID=
NEXT_PUBLIC_SITE_URL=https://treasure-coast-media.vercel.app

# Required to accept deposits and confirm paid bookings.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Required to access the admin upload page and sign its HttpOnly sessions.
CLIENT_PORTAL_PASSWORD=
PORTAL_SESSION_SECRET=

# Optional paid-booking notification integration.
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=

# Media delivery platform: Supabase (service role key is server-only, never expose it).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (private bucket). The bucket needs a CORS rule allowing PUT/GET from the site origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional. Only set if this domain exposes ONLY watermarked "preview-" objects publicly;
# otherwise leave empty and previews are served via short-lived signed URLs.
R2_PUBLIC_DOMAIN=

# Delivery paywall: separate Stripe endpoint /api/webhooks/stripe (falls back to STRIPE_WEBHOOK_SECRET).
STRIPE_DELIVERY_WEBHOOK_SECRET=
ADMIN_NOTIFICATION_EMAIL=
